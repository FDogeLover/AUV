#!/bin/sh
#
# pre-commit hook — 自动检查
#
#   1. 固件 .c/.h 编码是否被改变
#   2. pi_send() 是否被注释
#   3. Python 文件语法
#   4. 新增文件中是否含 wiringpi 依赖
#
# 设为非零退出码会阻止 commit，当前只 WARN 不阻断。
# 如需严格模式，将 WARN=0 改为 WARN=1。
#
WARN=0  # 0=仅警告不阻断, 1=阻断提交

RED='\033[0;31m'
YEL='\033[1;33m'
GRN='\033[0;32m'
CYN='\033[0;36m'
NC='\033[0m' # No Color

HAS_ERROR=0

# ---------- Helper: 检测编码 ----------
detect_encoding() {
    python3 -c "
import sys
raw = open('$1', 'rb').read()
if not raw:
    sys.exit(0)
if all(b < 128 for b in raw):
    print('ascii')
    sys.exit(0)
# Try utf-8
try:
    raw.decode('utf-8')
    utf8_ok = True
except:
    utf8_ok = False
# Try gbk
try:
    raw.decode('gbk')
    gbk_ok = True
except:
    gbk_ok = False
if utf8_ok and not gbk_ok:
    print('utf-8')
elif gbk_ok and not utf8_ok:
    print('gbk')
elif utf8_ok and gbk_ok:
    # Check which one has valid Chinese
    utf8_text = raw.decode('utf-8')
    gbk_text = raw.decode('gbk')
    utf8_garbled = '\ufffd' in utf8_text
    gbk_garbled = '\ufffd' in gbk_text
    if not utf8_garbled and gbk_garbled:
        print('utf-8')
    elif utf8_garbled and not gbk_garbled:
        print('gbk')
    else:
        print('gbk')  # default for firmware files
else:
    print('unknown')
" 2>/dev/null || echo "unknown"
}

# ---------- Check 1: .c/.h 编码检查 ----------
echo ""
echo "${CYN}═══════════════════════════════════════${NC}"
echo "${CYN}  pre-commit: 编码 & 一致性检查${NC}"
echo "${CYN}═══════════════════════════════════════${NC}"

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for f in $STAGED_FILES; do
    case "$f" in
        *.c|*.h)
            # 只检查飞控固件目录下的
            case "$f" in
                *ANO_LX_FC_倾角保护版/*|*ANO_LX_FC_T265*)
                    # 检测暂存区版本的编码
                    staged_content=$(git show :"$f" 2>/dev/null)
                    if [ -z "$staged_content" ]; then
                        continue
                    fi

                    # 写临时文件检测
                    tmpfile=$(mktemp)
                    echo "$staged_content" > "$tmpfile"
                    enc=$(detect_encoding "$tmpfile")
                    rm -f "$tmpfile"

                    if [ "$enc" = "unknown" ]; then
                        printf "${RED}  ✗ 编码未知: %s${NC}\n" "$f"
                        HAS_ERROR=1
                    else
                        # 与已提交版本对比
                        prev_enc=$(git show HEAD:"$f" 2>/dev/null | python3 -c "
import sys
raw = sys.stdin.buffer.read()
if not raw:
    sys.exit(0)
# Try utf-8 and gbk
utf8_ok = False
gbk_ok = False
try:
    raw.decode('utf-8')
    utf8_ok = True
except: pass
try:
    raw.decode('gbk')
    gbk_ok = True
except: pass
if utf8_ok and gbk_ok:
    print('ambiguous')
elif utf8_ok:
    print('utf-8')
elif gbk_ok:
    print('gbk')
else:
    print('unknown')
" 2>/dev/null || echo "none")

                        if [ "$prev_enc" != "none" ] && [ "$prev_enc" != "$enc" ] && [ "$prev_enc" != "ambiguous" ]; then
                            printf "${RED}  ⚠ 编码改变: %s  %s → %s${NC}\n" "$f" "$prev_enc" "$enc"
                            HAS_ERROR=1
                        else
                            printf "${GRN}  ✓ %-35s [%s]${NC}\n" "$(basename $f)" "$enc"
                        fi
                    fi
                    ;;
            esac
            ;;
    esac
done

# ---------- Check 2: pi_send() 状态 ----------
echo ""
echo "${CYN}--- pi_send() 状态 ---${NC}"
PI_SEND_FILE="ANO_LX_FC_倾角保护版/FcSrc/Ano_Scheduler.c"
if [ -f "$PI_SEND_FILE" ]; then
    if grep -q "//.*pi_send" "$PI_SEND_FILE"; then
        printf "${RED}  ⚠ pi_send() 被注释！下行链路中断${NC}\n"
        printf "     紧急停、高度回传均会失效\n"
        HAS_ERROR=1
    else
        printf "${GRN}  ✓ pi_send() 正常${NC}\n"
    fi
fi

# ---------- Check 3: Python 语法 ----------
echo ""
echo "${CYN}--- Python 语法 ---${NC}"
for f in $STAGED_FILES; do
    case "$f" in
        *.py)
            content=$(git show :"$f" 2>/dev/null)
            if [ -n "$content" ]; then
                tmpfile=$(mktemp)
                echo "$content" > "$tmpfile"
                python3 -m py_compile "$tmpfile" 2>/dev/null
                if [ $? -ne 0 ]; then
                    printf "${RED}  ✗ 语法错误: %s${NC}\n" "$f"
                    python3 -m py_compile "$tmpfile" 2>&1 | head -3
                    HAS_ERROR=1
                else
                    printf "${GRN}  ✓ %-35s syntax OK${NC}\n" "$(basename $f)"
                fi
                rm -f "$tmpfile"
            fi
            ;;
    esac
done

# ---------- Check 4: wiringpi 依赖检查 ----------
echo ""
echo "${CYN}--- wiringpi 依赖检查 ---${NC}"
for f in $STAGED_FILES; do
    case "$f" in
        *.py)
            if git show :"$f" 2>/dev/null | grep -q "wiringpi"; then
                case "$f" in
                    *basic/*)
                        printf "${RED}  ⚠ basic/ 目录不应依赖 wiringpi: %s${NC}\n" "$f"
                        HAS_ERROR=1
                        ;;
                esac
            fi
            ;;
    esac
done
if [ "$HAS_ERROR" -eq 0 ]; then
    printf "${GRN}  ✓ 无 wiringpi 依赖问题${NC}\n"
fi

# ---------- 结果 ----------
echo ""
if [ "$HAS_ERROR" -ne 0 ]; then
    if [ "$WARN" -eq 1 ]; then
        printf "${RED}✗ pre-commit 检查未通过，提交已阻断${NC}\n"
        printf "  如需强制提交: git commit --no-verify\n"
        exit 1
    else
        printf "${YEL}⚠ 发现潜在问题 (仅警告，未阻断提交)${NC}\n"
        printf "  设为严格模式: 将 .githooks/pre-commit 中 WARN=0 改为 WARN=1\n"
        exit 0
    fi
else
    printf "${GRN}✓ 全部检查通过${NC}\n"
    exit 0
fi
